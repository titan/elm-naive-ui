bridge : String
bridge =
    "/* ===== elm-ui bridge =====\n *\n * Components are built from elm-ui elements, and elm-ui styles its flex helpers in a\n * way Naive UI does not expect:\n *\n *   .s.r > .s  { flex-basis: 0% }\n *   .s.c > .s  { flex-basis: 0px; min-height: min-content }\n *\n * Naive UI components are ordinary elements (flex-basis / min-height default), so a\n * `flex-basis: 0` would shrink them to their min-content width. Naive UI's own rules\n * always win on specificity (they are scoped under `.nui-root.nui-root`), but these\n * two properties are *not declared* by Naive UI, so they must be restored here.\n *\n * Any element carrying a Naive UI class (`n-button`, `n-button__icon`, ...) gets the\n * browser defaults back.\n */\n.nui-root.nui-root [class^=\"n-\"],\n.nui-root.nui-root [class*=\" n-\"] {\n  flex-basis: auto;\n}\n\n/* elm-ui's `.s.e` sets `white-space: pre`; Naive UI relies on normal/`nowrap`\n * inherited from its own rules. Only reset elements Naive UI does not itself style. */\n.nui-root.nui-root [class^=\"n-button__\"],\n.nui-root.nui-root [class*=\" n-button__\"] {\n  white-space: normal;\n}\n\n.nui-root.nui-root .n-button.n-button {\n  white-space: nowrap;\n}\n"

