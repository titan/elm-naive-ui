bridge : String
bridge =
    "/* ===== elm-ui bridge =====\n *\n * Components are built from elm-ui elements, and elm-ui styles its own helper classes\n * in a way Naive UI does not expect. Naive UI's rules always win where it declares a\n * property (they are scoped `.nui-root.nui-root`, i.e. three class selectors), so this\n * file only restores browser defaults for properties Naive UI leaves alone.\n */\n\n/* 1. `flex-basis`\n *\n *   .s.r > .s { flex-basis: 0% }\n *   .s.c > .s { flex-basis: 0px; min-height: min-content }\n *\n * Naive UI components are ordinary elements (flex-basis: auto), and a 0 basis would\n * shrink them to min-content. Naive UI never declares flex-basis, so a doubly-scoped\n * rule is safe.\n */\n.nui-root.nui-root [class^=\"n-\"],\n.nui-root.nui-root [class*=\" n-\"] {\n  flex-basis: auto;\n}\n\n/* 2. `line-height`\n *\n * elm-ui's `.s { line-height: 1 }` (one class selector) is applied to every element\n * wrapper, which breaks Naive UI's inherited line-height chain (e.g. `.n-alert` sets\n * `line-height: var(--n-line-height)` and expects descendants to inherit it).\n *\n * A single `.nui-root` prefix gives two class selectors: enough to beat elm-ui's `.s`,\n * but *less* than Naive UI's own doubly-scoped rules, so any component that declares a\n * line-height (e.g. `.n-button { line-height: 1 }`) keeps it.\n */\n.nui-root [class^=\"n-\"],\n.nui-root [class*=\" n-\"] {\n  line-height: inherit;\n}\n\n/* 3. `white-space`\n *\n * elm-ui's `.s.e` sets `white-space: pre`. Naive UI's components that need `nowrap`\n * declare it themselves (doubly scoped, so they win); this restores the default for the\n * Naive UI sub-elements that rely on inheritance.\n */\n.nui-root.nui-root [class^=\"n-button__\"],\n.nui-root.nui-root [class*=\" n-button__\"] {\n  white-space: normal;\n}\n\n.nui-root.nui-root .n-button.n-button {\n  white-space: nowrap;\n}\n"

