bridge : String
bridge =
    "/* ===== elm-ui bridge =====\n *\n * Components are built from elm-ui elements, and elm-ui styles its own helper classes\n * in a way Naive UI does not expect. Naive UI's rules always win where it declares a\n * property (they are scoped `.nui-root.nui-root`, i.e. three class selectors), so this\n * file only restores browser defaults for properties Naive UI leaves alone.\n */\n\n/* 1. `flex-basis`\n *\n *   .s.r > .s { flex-basis: 0% }\n *   .s.c > .s { flex-basis: 0px; min-height: min-content }\n *\n * Naive UI components are ordinary elements (flex-basis: auto), and a 0 basis would\n * shrink them to min-content. Naive UI never declares flex-basis, so a doubly-scoped\n * rule is safe.\n */\n.nui-root.nui-root [class^=\"n-\"],\n.nui-root.nui-root [class*=\" n-\"] {\n  flex-basis: auto;\n}\n\n/* 2. `line-height`\n *\n * elm-ui's `.s { line-height: 1 }` (one class selector) is applied to every element\n * wrapper, which breaks Naive UI's inherited line-height chain (e.g. `.n-alert` sets\n * `line-height: var(--n-line-height)` and expects descendants to inherit it).\n *\n * A single `.nui-root` prefix gives two class selectors: enough to beat elm-ui's `.s`,\n * but *less* than Naive UI's own doubly-scoped rules, so any component that declares a\n * line-height (e.g. `.n-button { line-height: 1 }`) keeps it.\n */\n.nui-root [class^=\"n-\"],\n.nui-root [class*=\" n-\"] {\n  line-height: inherit;\n}\n\n/* 3. `white-space`\n *\n * elm-ui's `.s.e` sets `white-space: pre`. Naive UI's components that need `nowrap`\n * declare it themselves (doubly scoped, so they win); this restores the default for the\n * Naive UI sub-elements that rely on inheritance.\n */\n.nui-root.nui-root [class^=\"n-button__\"],\n.nui-root.nui-root [class*=\" n-button__\"] {\n  white-space: normal;\n}\n\n.nui-root.nui-root .n-button.n-button {\n  white-space: nowrap;\n}\n\n/* 4. `flex-shrink` (input wrapper)\n *\n *   .s { flex-shrink: 0 }\n *\n * Upstream's `.n-input-wrapper` is a plain div: the browser default\n * `flex-shrink: 1` lets it collapse into a width-capped `.n-input`\n * (InputOtp's `--n-input-width` 24–36px slots), where `overflow: hidden` and\n * `.n-input__input-el { width: 100%; min-width: 0 }` re-fit the inner input and\n * center the character. The port renders the wrapper as an elm-ui row, and\n * elm-ui's `.s { flex-shrink: 0 }` (one class selector) wins because Naive UI's\n * wrapper rules only declare `flex-grow` — the wrapper then keeps the `<input>`'s\n * intrinsic ~174px width, and the centered digit lands outside the visible slot.\n *\n * This must stay targeted (unlike rules 1–2): Naive UI DOES declare `flex-shrink`\n * elsewhere (`.n-base-clear`, suffix/prefix…), some on 3-selector scoped roots\n * that a blanket `[class^=\"n-\"]` rule would tie and, being later in the file,\n * wrongly beat. A 4-selector rule touches only the one element upstream relies on.\n */\n.nui-root.nui-root .n-input .n-input-wrapper {\n  flex-shrink: 1;\n}\n\n/* 5. Select-menu ambient font-size (port-added)\n *\n * Upstream's `.n-base-select-group-header` sizes itself with `.93em` off the\n * menu root, which in a Vue app inherits the document's 14px body font. Under\n * elm-ui the menu root is an `Element` inside the caller's tree, so it\n * inherits whatever ambient `Font.size` the caller set (this showcase's demo\n * rows run 20px) — the `.93em` header then blows up to 18.6px.\n *\n * Pinning the menu root to the option font size reproduces upstream's\n * computed result under any ambient (options already carry the var directly,\n * so they are unaffected):\n */\n.nui-root.nui-root .n-base-select-menu {\n  font-size: var(--n-option-font-size);\n}\n\n/* 6. ColorPicker input-row flex slots (port-added)\n *\n * Upstream's `.n-color-picker-input` is a plain flex row: the `__mode` label\n * keeps its CSS `width: 72px` and the `NInputGroup` fills the rest, its unit\n * inputs sharing the remainder through `flex-grow: 1; flex-basis: 0`.\n *\n * Under elm-ui two defaults break that arithmetic:\n *   - the group is an `Element.row` whose children get `.s { flex-shrink: 0 }`,\n *     so each unit sticks at its min-content width (input intrinsic 34.75px\n *     + padding) and the four RGBA units overflow the 216px panel content;\n *   - the group itself is laid out at the full row width, so squeezing the\n *     row lands entirely on `__mode` (shrink 1), pinching 72px to ~40px and\n *     letting the units spill past the panel's right border.\n *\n * Restoring upstream's intent needs three targeted properties: the group\n * becomes a proper flex slot (`flex: 1 1 0; min-width: 0`), the units may\n * shrink below min-content (`min-width: 0`), and the label keeps its fixed\n * slot (`flex: 0 0 72px`) so the shrink no longer lands on it. Naive UI\n * declares none of flex/min-width here, so a doubly-scoped rule is safe.\n */\n.nui-root.nui-root .n-color-picker-input .n-color-picker-input__mode {\n  flex: 0 0 72px;\n}\n\n.nui-root.nui-root .n-color-picker-input .n-input-group {\n  flex: 1 1 0;\n  min-width: 0;\n}\n\n.nui-root.nui-root .n-color-picker-input .n-input-group .n-input {\n  min-width: 0;\n}\n\n/* The unit inputs' text slot: upstream's geometry (grow 1 / 1.25, padding\n * 0 4px) fits three digit channels plus \"100%\" in their demo font stack\n * (Arial-class, where \"100%\" ≈ 35.8px @14px). The port's showcase runs\n * `system-ui`, whose \"100%\" ≈ 40px @14px — one to four px wider per glyph\n * run — and the fixed 144px group cannot stretch (mode label is pinned at\n * 72px, panel content at 216px). Rather than bending the flex arithmetic\n * (any grow tweak that fits \"100%\" starves R/G/B below three digits), the\n * unit row drops to 12px with 3px side padding: every value then fits its\n * slot with margin (channels 22.9 ≤ 26.6, alpha 34.3 ≤ 35.2). Scoped to\n * the color-picker input row only — standalone inputs are unaffected.\n */\n.nui-root.nui-root .n-color-picker-input .n-input-group .n-input {\n  font-size: 12px;\n  --n-padding-left: 3px;\n  --n-padding-right: 3px;\n}\n\n/* 7. Heatmap loading keyframes (port-added)\n *\n * Upstream mounts this stylesheet at runtime (src/heatmap/src/animationStyle.ts):\n * a `heatmap-loading-<hash>` class whose name hashes the two loading colors, plus\n * matching keyframes. The colors are theme vars (`--n-loading-color-start/end`),\n * so the port replaces the hashed pair with one static rule on the existing\n * `--loading` modifier. Values are verbatim from upstream: 2s, infinite,\n * cubic-bezier(0.36, 0, 0.64, 1), keyframe stops 0/40/80/100%.\n */\n.nui-root.nui-root .n-heatmap-rect.n-heatmap-rect--loading {\n  animation: 2s n-heatmap-loading infinite cubic-bezier(0.36, 0, 0.64, 1);\n}\n\n@keyframes n-heatmap-loading {\n  0% {\n    background: var(--n-loading-color-start);\n  }\n  40% {\n    background: var(--n-loading-color-end);\n  }\n  80% {\n    background: var(--n-loading-color-start);\n  }\n  100% {\n    background: var(--n-loading-color-start);\n  }\n}\n\n/* 8. Checkbox label line-height (port-added)\n *\n * Upstream's `.n-checkbox__label` is a plain div whose raw text node builds\n * its line box on the component's `--n-label-line-height` (1.6 → 22.4px\n * @14px) — the same value the box wrapper's `&nbsp;` strut uses, so the\n * `top: 50%`-centered square and the label glyphs share one vertical center.\n *\n * The port's label content arrives as `Element`s, so the text sits inside\n * elm-ui wrappers (`.s.c`, `.s.t`) that each declare `line-height: 1`: the\n * half-leading vanishes and the glyphs render ~4.2px (half of 22.4 − 14)\n * above the square. Re-asserting the label var on the label and every\n * wrapper below it restores the 22.4px line box. The wrappers carry no\n * `n-*` class, so no Naive UI rule targets them; the 4-selector specificity\n * beats both elm-ui's `.s` and bridge rule 2's `inherit`, while staying\n * clear of any nested component root (a nested `.n-button` label keeps its\n * own `line-height: 1